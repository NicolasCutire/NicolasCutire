% Línea + etiqueta: se encoge si no cabe hasta el margen (no se sale).
\newcommand{\faltante}[2][4.5cm]{%
  \leavevmode\nobreak\hspace{0.1em}%
  {\color{tinta}\leaders\hrule height 0.45pt\hskip #1 minus #1}%
  \raisebox{-0.82em}[0pt][0pt]{\makebox[0pt][c]{\scriptsize\color{black!52}#2}}%
}
% En tablas: rellena el resto de la celda. Fuera: se corta al margen.
\newcommand{\linea}[1][4.2cm]{%
  \leavevmode
  \def\@linea@tabx{tabularx}%
  \ifx\@currenvir\@linea@tabx
    \hspace{0.12em}{\color{tinta}\leaders\hrule height 0.45pt\hfill}\kern0pt
  \else
    \nobreak\hspace{0.1em}%
    {\color{tinta}\leaders\hrule height 0.45pt\hskip #1 minus #1}\kern 0.04pt
  \fi
}
% Prefijo (Abog., Dr., Ing.) + línea en el renglón siguiente, sin salir del margen.
\newcommand{\NombreCompletable}[2][11.2cm]{%
  \ifhmode
    \unskip\newline
  \fi
  \leavevmode
  #2\nobreak\hspace{0.2em}%
  \settowidth{\dimen1}{#2 }%
  \dimen0=#1\relax
  \dimen2=\linewidth
  \advance\dimen2 by -\dimen1
  \advance\dimen2 by -0.3em
  \ifdim\dimen0>\dimen2
    \dimen0=\dimen2
  \fi
  \ifdim\dimen0<4.2cm
    \dimen0=\dimen2
  \fi
  {\color{tinta}\vrule height 0pt depth 0.45pt width \dimen0}%
}
% Completable que sigue el párrafo: llega al margen y, si falta tramo, sigue abajo.
% El texto posterior continúa en el mismo renglón. No usar en fechas.
\newcommand{\lineaEnvuelve}[1][6cm]{%
  \leavevmode
  \nobreak\hspace{0.12em}%
  \dimen2=#1\relax
  \loop
    \ifdim\dimen2>0.36cm
      \allowbreak
      {\color{tinta}\vrule height 0pt depth 0.45pt width 0.36cm}%
      \advance\dimen2 -0.36cm
  \repeat
  \ifdim\dimen2>0.05cm
    \allowbreak
    {\color{tinta}\vrule height 0pt depth 0.45pt width \dimen2}%
  \fi
}
\newcommand{\LineaRenglon}{\lineaEnvuelve[10cm]}
% Línea de ancho fijo (no se encoge a cero). Si no cabe, baja entera al renglón siguiente.
\newcommand{\lineaFija}[1][6.8cm]{%
  \leavevmode\penalty-50\hspace{0.12em}%
  \hbox{\color{tinta}\vrule height 0pt depth 0.45pt width #1}%
}
